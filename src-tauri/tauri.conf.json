{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dictaku",
  "version": "0.1.0",
  "identifier": "com.dictaku.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dictaku",
        "width": 280,
        "height": 80,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "url": "popup.html"
      },
      {
        "label": "settings",
        "title": "Dictaku — Paramètres",
        "width": 480,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "url": "settings.html"
      },
      {
        "label": "setup",
        "title": "Dictaku — Configuration initiale",
        "width": 420,
        "height": 460,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true,
        "url": "setup.html"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "Dictaku — Dictée vocale"
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/whisper-cli.exe"
    ]
  }
}
